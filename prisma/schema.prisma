generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum PreinscriptionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentStatus {
  PAYE
  EN_ATTENTE
  RETARD
}

enum StudentSex {
  M
  F
}

model Level {
  id              String           @id @default(cuid())
  code            String           @unique
  name            String
  cycle           String
  monthlyFee      Int
  students        Student[]
  preinscriptions Preinscription[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model Parent {
  id        String    @id @default(cuid())
  fullName  String
  phone     String    @unique
  email     String?
  address   String?
  students  Student[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Student {
  id        String     @id @default(cuid())
  matricule String     @unique
  firstName String
  lastName  String
  sex       StudentSex
  birthDate String
  photoUrl  String?
  levelId   String
  level     Level      @relation(fields: [levelId], references: [id])
  parentId  String
  parent    Parent     @relation(fields: [parentId], references: [id])
  payments  Payment[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Preinscription {
  id             String               @id @default(cuid())
  childFirstName String
  childLastName  String
  parentName     String
  parentPhone    String
  status         PreinscriptionStatus @default(PENDING)
  date           String
  levelId        String
  level          Level                @relation(fields: [levelId], references: [id])
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
}

model Payment {
  id            String        @id @default(cuid())
  month         String
  amount        Int
  paidAt        DateTime      @default(now())
  status        PaymentStatus @default(PAYE)
  method        String        @default("Wave")
  receiptNumber String        @unique
  studentId     String
  student       Student       @relation(fields: [studentId], references: [id])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Teacher {
  id        String   @id @default(cuid())
  fullName  String
  phone     String   @unique
  subject   String
  levels    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
